# Log và file tạm
*.log
scripts/.e2e-tmp/

# Backup KHÔNG commit. Bản mới nằm ở backups/ trong project để copy sang USB;
# các bản cũ đã chuyển ra D:/Aptis-Practise-Backups.
# Hai lý do không commit: dump MinIO từng đẩy .git lên 557M, và backups/**/.env
# đã lọt MAIL_PASSWORD cùng AI_EVAL_API_KEY vào lịch sử commit.
backups/

