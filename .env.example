# Mẫu biến môi trường. Chép thành .env rồi điền giá trị thật:
#
#   cp .env.example .env
#
# .env đã nằm trong .gitignore — KHÔNG commit file đó, nó chứa mật khẩu.
# Docker compose tự đọc .env ở thư mục gốc, không cần khai báo gì thêm.

# ---------------------------------------------------------------------
# Gửi email
# ---------------------------------------------------------------------
# Để trống MAIL_HOST (hoặc để "mailpit") thì dùng hộp thư giả Mailpit ở
# http://localhost:8025 — không gửi ra ngoài, tiện khi phát triển.
#
# Dùng Gmail thật: bật xác minh 2 bước cho tài khoản, rồi tạo App Password ở
# https://myaccount.google.com/apppasswords (16 ký tự). KHÔNG dùng mật khẩu
# đăng nhập Gmail — Google chặn từ 2022.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aptispractices@gmail.com
MAIL_PASSWORD=dan-app-password-16-ky-tu-vao-day
MAIL_FROM=aptispractices@gmail.com

# Hop thu nhan bao khi hoc vien khai da chuyen khoan (de doi soat sao ke)
TRANSFER_NOTIFY_EMAIL=admin@example.com

# ---------------------------------------------------------------------
# Bảo mật
# ---------------------------------------------------------------------
# Base64, tối thiểu 256 bit. Sinh mới: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi0xMjM0NTY3ODkw

# ---------------------------------------------------------------------
# Cổng dịch vụ (đổi nếu bị chiếm)
# ---------------------------------------------------------------------
MYSQL_HOST_PORT=3307
FRONTEND_HOST_PORT=80

# ---------------------------------------------------------------------
# Cờ vận hành
# ---------------------------------------------------------------------
# Bắt buộc bật khi chạy nhiều instance backend, nếu không scheduled job
# chạy trùng (email gửi hai lần, subscription xử lý hết hạn đồng thời).
SCHEDULER_LOCK=false

# Chu kỳ dọn file báo cáo quá hạn khỏi MinIO. Rút ngắn khi chạy e2e.
EXPORT_PURGE_INTERVAL=PT1H
EXPORT_PURGE_INITIAL_DELAY=PT2M

# Giả lập cổng thanh toán hoàn tiền bất đồng bộ (chờ webhook xác nhận).
SANDBOX_ASYNC_REFUND=false
